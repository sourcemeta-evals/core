    "$id": "https://www.example.com/entry",
    "items": {
      "$ref": "http://json-schema.org/draft-07/schema#"
    },
    "contains": {
      "$ref": "https://example.com/leaf"
    }
  },
  "resolver": {
    "http://json-schema.org/draft-07/schema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
