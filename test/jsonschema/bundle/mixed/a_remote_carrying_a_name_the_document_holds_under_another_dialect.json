{
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://example.com/host",
    "properties": {
      "x": {
        "$ref": "https://example.com/remote"
      }
    },
    "$defs": {
      "local": {
        "$id": "https://example.com/shared",
        "dependencies": {
          "a": [
            "b"
          ]
        }
      }
    }
  },
  "resolver": {
    "https://example.com/remote": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "$id": "https://example.com/remote",
      "properties": {
        "y": {
          "$ref": "https://example.com/shared"
        }
      },
      "definitions": {
        "shared": {
          "$id": "https://example.com/shared",
          "dependencies": {
            "a": [
              "b"
            ]
          }
        }
      }
    }
  },
  "result": {},
  "inserted": {},
  "errors": {
    "nonOfficialMetaschemas": {
      "type": "SchemaError",
      "message": "Conflicting embedded resources with the same identifier"
    },
    "references": {
      "type": "SchemaError",
      "message": "Conflicting embedded resources with the same identifier"
    }
  }
}
