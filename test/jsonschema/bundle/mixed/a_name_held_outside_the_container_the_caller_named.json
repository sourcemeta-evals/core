{
  "schema": {
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$ref": "https://www.sourcemeta.com/remote",
      "properties": {
        "pet": {
          "$id": "https://example.com/pet",
          "type": "string"
        }
      }
    },
    "bundled": {}
  },
  "resolver": {
    "https://www.sourcemeta.com/remote": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://www.sourcemeta.com/remote",
      "$defs": {
        "https://example.com/pet": {
          "$id": "https://example.com/pet",
          "type": "number"
        }
      }
    }
  },
  "paths": [
    "/schema"
  ],
  "container": "/bundled",
  "errors": {
    "nonOfficialMetaschemas": {
      "type": "SchemaError",
      "message": "Conflicting embedded resources with the same identifier"
    },
    "references": {
      "type": "SchemaError",
      "message": "Conflicting embedded resources with the same identifier"
    }
  },
  "result": {},
  "inserted": {}
