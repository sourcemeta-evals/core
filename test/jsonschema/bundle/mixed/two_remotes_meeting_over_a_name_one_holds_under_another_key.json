{
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "allOf": [
      {
        "$ref": "https://www.sourcemeta.com/first"
      },
      {
        "$ref": "https://www.sourcemeta.com/second"
      }
    ]
  },
  "resolver": {
    "https://www.sourcemeta.com/first": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://www.sourcemeta.com/first",
      "$defs": {
        "other": {
          "$id": "https://example.com/child",
          "type": "string"
        }
      }
    },
    "https://www.sourcemeta.com/second": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://www.sourcemeta.com/second",
      "properties": {
        "carried": {
          "$id": "https://example.com/child",
          "type": "string"
        }
      }
    }
  },
  "errors": {
    "nonOfficialMetaschemas": {
      "type": "SchemaError",
      "message": "Conflicting embedded resources with the same identifier"
    },
    "references": {
      "type": "SchemaError",
      "message": "Conflicting embedded resources with the same identifier"
    }
  },
  "result": {},
  "inserted": {}
}
