{
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "allOf": [
      {
        "$ref": "https://example.com/shared"
      },
      {
        "$ref": "https://example.com/legacy"
      }
    ]
  },
  "resolver": {
    "https://example.com/shared": {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "https://example.com/shared",
      "type": "string"
    },
    "https://example.com/legacy": {
      "$schema": "http://json-schema.org/draft-04/schema#",
      "id": "https://example.com/legacy",
      "definitions": {
        "https://example.com/shared": {
          "$id": false,
          "id": "https://example.com/shared",
          "type": "number"
        }
      }
    }
  },
  "errors": {
    "nonOfficialMetaschemas": {
      "type": "SchemaError",
      "message": "Conflicting embedded resources with the same identifier"
    },
    "references": {
      "type": "SchemaError",
      "message": "Conflicting embedded resources with the same identifier"
    }
  },
  "result": {},
  "inserted": {}
}
