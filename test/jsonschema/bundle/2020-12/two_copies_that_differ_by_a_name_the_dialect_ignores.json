        }
      },
      "$defs": {
        "https://example.com/shared": {
          "$id": "https://example.com/shared",
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "id": "payload-two",
          "type": "string"
        }
      }
    }
  },
  "result": {},
  "inserted": {},
  "errors": {
    "nonOfficialMetaschemas": {
      "type": "SchemaError",
      "message": "Conflicting embedded resources with the same identifier"
    },
    "references": {
      "type": "SchemaError",
      "message": "Conflicting embedded resources with the same identifier"
    }
  }
