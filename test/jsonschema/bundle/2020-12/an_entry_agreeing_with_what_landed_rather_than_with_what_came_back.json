{
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://example.com/host",
    "properties": {
      "a": { "$ref": "https://example.com/a" },
      "b": { "$ref": "https://example.com/b" }
    }
  },
  "resolver": {
    "https://example.com/a": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://example.com/a",
      "$defs": {
        "https://example.com/y": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "$id": "https://example.com/y",
          "type": "string"
        }
      }
    },
    "https://example.com/b": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://example.com/b",
      "$defs": {
        "https://example.com/a": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "$id": "https://example.com/a"
        }
      }
    }
  },
  "result": {},
  "inserted": {},
  "errors": {
    "nonOfficialMetaschemas": {
      "type": "SchemaError",
      "message": "Conflicting embedded resources with the same identifier"
    },
    "references": {
      "type": "SchemaError",
      "message": "Conflicting embedded resources with the same identifier"
    }
  }
}
