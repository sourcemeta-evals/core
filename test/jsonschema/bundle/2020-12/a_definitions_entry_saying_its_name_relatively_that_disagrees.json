{
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://example.com/host",
    "properties": { "pet": { "$ref": "https://example.com/pet" } },
    "$defs": { "shared": { "$id": "https://example.com/shared", "type": "string" } }
  },
  "resolver": {
    "https://example.com/pet": {
      "$id": "https://example.com/pet",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": { "label": { "$ref": "https://example.com/shared" } },
      "$defs": { "shared": { "$id": "shared", "type": "number" } }
    }
  },
  "result": {},
  "inserted": {},
  "errors": {
    "nonOfficialMetaschemas": { "type": "SchemaError", "message": "Conflicting embedded resources with the same identifier" },
    "references": { "type": "SchemaError", "message": "Conflicting embedded resources with the same identifier" }
  }
}
